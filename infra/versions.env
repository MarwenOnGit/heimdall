# Every pinned tool, image and chart version. Sourced by the scripts in infra/.
# Change a version here, nowhere else.

# --- cluster ---
CLUSTER_NAME=heimdall
KIND_NODE_IMAGE=kindest/node:v1.36.1@sha256:3489c7674813ba5d8b1a9977baea8a6e553784dab7b84759d1014dbd78f7ebd5

# --- local registry ---
REGISTRY_NAME=heimdall-registry
REGISTRY_PORT=5001
REGISTRY_IMAGE=registry:2.8.3

# --- CLI tools downloaded into .bin/ by infra/tools.sh ---
HELM_VERSION=v4.3.1
OPA_VERSION=v1.22.3

# --- Helm charts (repo URL and chart version) ---
PROM_STACK_REPO=https://prometheus-community.github.io/helm-charts
PROM_STACK_VERSION=93.1.2
LOKI_REPO=https://grafana.github.io/helm-charts
LOKI_VERSION=7.6.0
ALLOY_REPO=https://grafana.github.io/helm-charts
ALLOY_VERSION=1.15.0
ARGOCD_REPO=https://argoproj.github.io/argo-helm
ARGOCD_VERSION=10.17.1
CHAOS_MESH_REPO=https://charts.chaos-mesh.org
CHAOS_MESH_VERSION=2.8.8
GITEA_REPO=https://dl.gitea.com/charts/
GITEA_VERSION=12.7.0
LINKERD_REPO=https://helm.linkerd.io/edge
LINKERD_VERSION=2026.11.1


# --- pull-through image caches (one per upstream registry) ---
REGISTRY_CACHE_IMAGE=registry:3.1.2

# --- bad-release images (fault-images/) ---
GO_IMAGE=golang:1.27.4-alpine
BOUTIQUE_FRONTEND_IMAGE=us-central1-docker.pkg.dev/online-boutique-ci/microservices-demo/frontend:v0.10.7

# --- Heimdall image build ---
PYTHON_IMAGE=python:3.12-slim
UV_IMAGE=ghcr.io/astral-sh/uv:0.12.5

# --- relay that exposes the host's Ollama to the cluster ---
SOCAT_IMAGE=alpine/socat:1.8.1.3
